# Bytecode, environments, and notebooks
__pycache__/
*.py[cod]
*.egg-info/
.Python
.venv/
venv/
env/
.env
.ipynb_checkpoints/

# Editors
.idea/
.vscode/

# Trained weights stay local. Download or train them, then place
# object_detectionv3.h5 in models/. See README.md.
*.h5
*.hdf5
*.pb
*.ckpt
*.onnx
models/logs/
module_webapp/static/models/

# Raw images live on Kaggle, not in git
number_Plate_raw/

# Third-party tools and course trees (not part of this pipeline)
labelimg-master/
tesseract-ocr-tesseract-b1cb50d/
ABNPR/

# Superseded annotation dumps. The canonical file is csv_label/final_labels.csv
csv_label/labels.csv
csv_label/labelsv2.csv

# Local test photographs (~300 MB). Use the Kaggle dataset to reproduce them.
test/

# Runtime uploads and crops generated by the Flask app
module_webapp/static/upload/*
!module_webapp/static/upload/.gitkeep
module_webapp/static/predict/*
!module_webapp/static/predict/.gitkeep
module_webapp/static/roi/*
!module_webapp/static/roi/.gitkeep

# Full-desktop captures. The published figure is docs/figures/webapp_result.jpg
sample_scrnshot/

